# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.3.0 Project Minimal Configuration
#
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.13.8"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_CHROMATIC_FW_VER_STR="4.6"
CONFIG_CONSOLE_SORTED_HELP=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LV_COLOR_CHROMA_KEY_HEX=0xFF00FF
CONFIG_LV_USE_ASSERT_STYLE=y
CONFIG_LV_SPRINTF_USE_FLOAT=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

# --- RAM tuning for WiFi + BLE coexistence (scan/observer only) ---
# Free IRAM: run WiFi code from flash instead
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Shrink WiFi DRAM buffers (we only scan/sniff, never carry traffic)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Shrink BT controller footprint
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BTDM_SCAN_DUPL_CACHE_SIZE=20
# Shrink NimBLE host buffers (observer/scan-only needs very little)
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=6
CONFIG_BT_NIMBLE_ACL_BUF_SIZE=128
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=10
CONFIG_BT_NIMBLE_HCI_EVT_LO_BUF_COUNT=4
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=2
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=2

CONFIG_LV_FONT_MONTSERRAT_14=y
